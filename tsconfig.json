{
    "compilerOptions": {
        "outDir": "dist/js",
        "target": "es6",
        "skipLibCheck": true,
        "maxNodeModuleJsDepth": 0,
        "noEmitOnError": true,
        "noImplicitAny": true,
        "removeComments": true,
        "strictNullChecks": true
    },
    "include": ["app/**/*"],
    "exclude": ["node_modules"]
}